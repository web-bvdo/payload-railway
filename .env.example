# Copy this file to .env and fill it in.  Tip: `npm run setup` does this for you
# and generates a PAYLOAD_SECRET automatically.

# --- Database (Postgres) ---
# Local development: point this at a LOCAL Postgres. The schema comes from the
# migrations (`npm run migrate`), also locally. See docs/DEVELOPING.md.
#   docker run --name pg -e POSTGRES_PASSWORD=pw -p 5432:5432 -d postgres:16
DATABASE_URI=postgresql://postgres:pw@localhost:5432/postgres
# ⚠️ Never point this at a Railway database: a local migration or a wrong
# `migrate:create` would change that environment directly. Local = your own database.
# On Railway itself you don't set this — the Postgres service injects DATABASE_URL
# and the config reads that.

# --- Media storage ---
# Production: an S3-compatible bucket (Railway Bucket / Cloudflare R2). Uploads
# in the admin persist and are shared across dev/prod. On Railway these come
# from the Bucket service; set them in the dashboard, not here.
#   S3_BUCKET=<bucket name>
#   S3_ENDPOINT=<https://...>
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<key>
#   S3_SECRET_ACCESS_KEY=<secret>
# Local dev: leave S3_BUCKET unset → uploads fall back to ./media on disk.
# (MEDIA_DIR overrides the local folder if you ever need to.)

# --- Payload secret ---
# MUST be unique per site. Never reuse across client sites. Keep it out of git.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME

# --- First admin user (used by `npm run seed`) ---
# Unique per site. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- SEO ---
# Het echte domein. Alleen op de production-omgeving, bij livegang. Zonder SITE_URL
# (en op elk ander domein) krijgt de site noindex. Lokaal leeg laten. Zie docs/SEO.md.
#   SITE_URL=https://www.klant.nl

# --- E-mail (uitgaand: formulieren, wachtwoord-reset van admins) ---
# Kies bij livegang ÉÉN provider; beide gezet = fout bij het opstarten. Niets gezet =
# geen verzending, Payload logt mails alleen in de console (prima lokaal). Alleen op de
# production-omgeving. Zie docs/EMAIL.md.
#
# Afzender (beide providers). Bij Microsoft 365 = de mailbox waaruit verstuurd wordt.
#   EMAIL_FROM=website@klant.nl
#   EMAIL_FROM_NAME=Klant
#
# Optie 1, SMTP: een transactionele dienst (Resend, Brevo, Postmark). Standaardkeuze:
# alleen DNS-records bij de klant nodig. Resend: host smtp.resend.com, user resend,
# pass = API-key, poort 587 (of 2587 als Railway 587 blokkeert).
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<api-key>
# (SMTP_FROM / SMTP_FROM_NAME werken nog als oudere namen voor EMAIL_FROM / EMAIL_FROM_NAME.)
#
# Optie 2, Microsoft 365 (Graph API): als de klant via zijn eigen M365 wil mailen
# (komt in Verzonden items). De IT-beheerder van de klant maakt een app registration aan.
#   MS_TENANT_ID=<tenant-id>
#   MS_CLIENT_ID=<client-id>
#   MS_CLIENT_SECRET=<client-secret>   (verloopt: portal max. 24 maanden, via CLI langer, zie docs/EMAIL.md)

# --- Cookiebanner (Usercentrics) ---
# Settings-ID uit de Usercentrics-omgeving van de klant. Alleen op de production-
# omgeving; de banner laadt alleen op het domein uit SITE_URL. Lokaal leeg laten.
# Zie docs/SEO.md.
USERCENTRICS_ID=
