# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env (secrets — never commit). Ignore every .env* except the example.
.env
.env.*
!.env.example

# Local uploads (no S3_BUCKET) land in ./media. Never commit them: production media
# lives in the Bucket; design images that ship with the code go in public/images/.
/media

# stray local SQLite (only if someone runs the old adapter) — never commit.
payload.db
payload.db-*

# misc
.DS_Store
*.pem
npm-debug.log*

# editors
/.idea/*
!/.idea/runConfigurations

# vercel
.vercel

# Playwright
/test-results/
/playwright-report/
